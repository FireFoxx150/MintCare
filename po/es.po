#: mintcare/boot.py:11
msgid ""
"Holds up boot until the network is up. Only needed for network shares "
"mounted from /etc/fstab."
msgstr ""
"Retrasa el arranque hasta que haya red. Solo hace falta para recursos de red "
"montados desde /etc/fstab."

#: mintcare/boot.py:13
msgid ""
"Holds up boot until the network is up. Only needed for network shares "
"mounted at boot."
msgstr ""
"Retrasa el arranque hasta que haya red. Solo hace falta para recursos de red "
"montados al arrancar."

#: mintcare/boot.py:14
msgid ""
"Mobile-broadband (3G/4G/5G) modem support. Not needed without a cellular "
"modem."
msgstr ""
"Soporte para módems de banda ancha móvil (3G/4G/5G). No hace falta sin módem "
"móvil."

#: mintcare/boot.py:15
msgid ""
"Auto-discovers network printers. Printers you have already added keep "
"working."
msgstr ""
"Descubre impresoras de red automáticamente. Las impresoras que ya añadiste "
"siguen funcionando."

#: mintcare/boot.py:17
msgid ""
"smartd background disk monitor. MintCare's Hardware page and scan read SMART "
"data on demand, but you lose smartd's continuous logging of early failure "
"signs."
msgstr ""
"Vigilancia de discos en segundo plano (smartd). La página Hardware y el "
"análisis de MintCare leen los datos SMART cuando hace falta, pero pierdes el "
"registro continuo de smartd de las primeras señales de fallo."

#: mintcare/boot.py:19
msgid ""
"Local AI model server. Start it when needed with: systemctl start ollama"
msgstr ""
"Servidor local de modelos de IA. Inícialo cuando lo necesites con: systemctl "
"start ollama"

#: mintcare/boot.py:20
msgid ""
"Docker engine. If docker.socket stays enabled it still starts on first use."
msgstr ""
"Motor de Docker. Si docker.socket sigue activado, se inicia igualmente la "
"primera vez que se usa."

#: mintcare/boot.py:21
msgid "Container runtime used by Docker; started on demand by Docker."
msgstr ""
"Runtime de contenedores que usa Docker; Docker lo inicia cuando lo necesita."

#: mintcare/boot.py:22
msgid "Sends kernel crash reports to kerneloops.org."
msgstr "Envía informes de fallos del kernel a kerneloops.org."

#: mintcare/boot.py:23
msgid "TeamViewer remote-access daemon. TeamViewer can start it when launched."
msgstr ""
"Servicio de acceso remoto de TeamViewer. TeamViewer puede iniciarlo al "
"abrirse."

#: mintcare/boot.py:24
msgid "AnyDesk remote-access daemon."
msgstr "Servicio de acceso remoto de AnyDesk."

#: mintcare/boot.py:25
msgid "Cleans up after ext4 online checks. Harmless to disable."
msgstr ""
"Limpia después de las comprobaciones de ext4 en línea. Desactivarlo no causa "
"problemas."

#: mintcare/boot.py:26
msgid ""
"Virtual-machine manager. Socket activation starts it when virt-manager opens."
msgstr ""
"Gestor de máquinas virtuales. La activación por socket lo inicia al abrir "
"virt-manager."

#: mintcare/boot.py:27
msgid "Apache web server, often pulled in as a dependency."
msgstr "Servidor web Apache, a menudo instalado como dependencia."

#: mintcare/boot.py:28
msgid "nginx web server."
msgstr "Servidor web nginx."

#: mintcare/boot.py:29
msgid "MySQL database server."
msgstr "Servidor de bases de datos MySQL."

#: mintcare/boot.py:30
msgid "MariaDB database server."
msgstr "Servidor de bases de datos MariaDB."

#: mintcare/boot.py:31
msgid "PostgreSQL database server."
msgstr "Servidor de bases de datos PostgreSQL."

#: mintcare/boot.py:32
msgid "Postfix mail server, rarely needed on a desktop."
msgstr "Servidor de correo Postfix, rara vez necesario en un escritorio."

#: mintcare/boot.py:33
msgid "LVM monitoring. Only needed if you use LVM volumes."
msgstr "Supervisión de LVM. Solo hace falta si usas volúmenes LVM."

#: mintcare/boot.py:36
msgid ""
"A drive mounted from /etc/fstab. Adding the options 'nofail,x-systemd."
"automount' mounts it on first access instead of during boot."
msgstr ""
"Un disco montado desde /etc/fstab. Añadir las opciones 'nofail,x-systemd."
"automount' lo monta al primer acceso en lugar de durante el arranque."

#: mintcare/boot.py:107
msgid "Already disabled, but still started because "
msgstr "Ya está desactivado, pero se sigue iniciando porque "

#: mintcare/boot.py:108
msgid "another service"
msgstr "otro servicio"

