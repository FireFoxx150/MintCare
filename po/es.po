msgstr "El servidor de sonido no está en marcha"

#: mintcare/troubleshoot.py:53
msgid "No sound outputs found — the sound card or driver isn't detected"
msgstr ""
"No se encontraron salidas de sonido — no se detecta la tarjeta de sonido o "
"su controlador"

#: mintcare/troubleshoot.py:57
#, python-brace-format
