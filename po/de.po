#: mintcare/backup.py:81
msgid "No backup destination chosen yet"
msgstr "Noch kein Sicherungsziel ausgewählt"

#: mintcare/backup.py:84
#, python-brace-format
msgid "{0} isn't available — is the drive connected and mounted?"
msgstr ""
"{0} ist nicht verfügbar — ist das Laufwerk angeschlossen und eingehängt?"

#: mintcare/backup.py:86
#, python-brace-format
msgid "You can't write to {0}"
msgstr "Sie können nicht in {0} schreiben"

#: mintcare/backup.py:89
msgid ""
"This folder is on the same drive as your home folder — if that drive fails, "
"the backup goes with it. Choose another drive."
msgstr ""
"Dieser Ordner liegt auf demselben Laufwerk wie Ihr persönlicher Ordner — "
"fällt das Laufwerk aus, ist auch die Sicherung weg. Wählen Sie ein anderes "
"Laufwerk."

#: mintcare/backup.py:95
#, python-brace-format
msgid ""
"The drive uses {0}, which can't hard-link files, so every snapshot is a full "
"copy. ext4 or NTFS saves a lot of space."
msgstr ""
"Das Laufwerk verwendet {0}, das keine harten Links kann, daher ist jeder "
"Schnappschuss eine Vollkopie. ext4 oder NTFS sparen viel Platz."

#: mintcare/backup.py:97
msgid "unknown filesystem"
msgstr "unbekanntes Dateisystem"

#: mintcare/backup.py:97
#, python-brace-format
msgid "{0} free on the destination ({1})"
msgstr "{0} frei am Ziel ({1})"

#: mintcare/backup.py:114
msgid "None of the chosen folders exist"
msgstr "Keiner der gewählten Ordner existiert"

#: mintcare/backup.py:150
#, python-brace-format
