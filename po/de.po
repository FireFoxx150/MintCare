#, python-brace-format
msgid "{0} files changed"
msgstr "{0} Dateien geändert"

#: mintcare/backup.py:271
msgid "This isn't a MintCare settings file"
msgstr "Das ist keine MintCare-Einstellungsdatei"

#: mintcare/boot.py:11
msgid ""
"Holds up boot until the network is up. Only needed for network shares "
"mounted from /etc/fstab."
msgstr ""
"Hält den Start auf, bis das Netzwerk bereit ist. Nur für Netzwerkfreigaben "
"aus /etc/fstab nötig."

#: mintcare/boot.py:13
msgid ""
"Holds up boot until the network is up. Only needed for network shares "
"mounted at boot."
msgstr ""
"Hält den Start auf, bis das Netzwerk bereit ist. Nur für beim Start "
"eingehängte Netzwerkfreigaben nötig."

#: mintcare/boot.py:14
msgid ""
"Mobile-broadband (3G/4G/5G) modem support. Not needed without a cellular "
"modem."
msgstr ""
"Unterstützung für Mobilfunkmodems (3G/4G/5G). Ohne Mobilfunkmodem unnötig."

#: mintcare/boot.py:15
msgid ""
"Auto-discovers network printers. Printers you have already added keep "
"working."
msgstr ""
"Findet Netzwerkdrucker automatisch. Bereits hinzugefügte Drucker "
"funktionieren weiter."

#: mintcare/boot.py:17
msgid ""
"smartd background disk monitor. MintCare's Hardware page and scan read SMART "
"data on demand, but you lose smartd's continuous logging of early failure "
"signs."
msgstr ""
"smartd-Laufwerksüberwachung im Hintergrund. Die Hardware-Seite und der Scan "
"von MintCare lesen SMART-Daten bei Bedarf, aber die laufende Protokollierung "
"früher Ausfallanzeichen durch smartd entfällt."

#: mintcare/boot.py:19
msgid ""
"Local AI model server. Start it when needed with: systemctl start ollama"
msgstr ""
"Lokaler KI-Modellserver. Bei Bedarf starten mit: systemctl start ollama"

#: mintcare/boot.py:20
msgid ""
"Docker engine. If docker.socket stays enabled it still starts on first use."
msgstr ""
"Docker-Engine. Bleibt docker.socket aktiviert, startet sie trotzdem bei der "
"ersten Nutzung."

#: mintcare/boot.py:21
msgid "Container runtime used by Docker; started on demand by Docker."
msgstr "Container-Laufzeit von Docker; Docker startet sie bei Bedarf."

#: mintcare/boot.py:22
msgid "Sends kernel crash reports to kerneloops.org."
msgstr "Sendet Kernel-Absturzberichte an kerneloops.org."

#: mintcare/boot.py:23
msgid "TeamViewer remote-access daemon. TeamViewer can start it when launched."
msgstr ""
"TeamViewer-Fernzugriffsdienst. TeamViewer kann ihn beim Öffnen starten."

#: mintcare/boot.py:24
msgid "AnyDesk remote-access daemon."
msgstr "AnyDesk-Fernzugriffsdienst."

#: mintcare/boot.py:25
msgid "Cleans up after ext4 online checks. Harmless to disable."
msgstr "Räumt nach ext4-Online-Prüfungen auf. Deaktivieren ist unbedenklich."

#: mintcare/boot.py:26
msgid ""
"Virtual-machine manager. Socket activation starts it when virt-manager opens."
msgstr ""
"Verwaltung virtueller Maschinen. Socket-Aktivierung startet sie, wenn virt-"
"manager geöffnet wird."

#: mintcare/boot.py:27
msgid "Apache web server, often pulled in as a dependency."
msgstr "Apache-Webserver, oft als Abhängigkeit mitinstalliert."

#: mintcare/boot.py:28
msgid "nginx web server."
msgstr "nginx-Webserver."

#: mintcare/boot.py:29
msgid "MySQL database server."
msgstr "MySQL-Datenbankserver."

#: mintcare/boot.py:30
msgid "MariaDB database server."
msgstr "MariaDB-Datenbankserver."

#: mintcare/boot.py:31
msgid "PostgreSQL database server."
msgstr "PostgreSQL-Datenbankserver."

#: mintcare/boot.py:32
msgid "Postfix mail server, rarely needed on a desktop."
msgstr "Postfix-Mailserver, auf einem Desktop selten nötig."

#: mintcare/boot.py:33
msgid "LVM monitoring. Only needed if you use LVM volumes."
msgstr "LVM-Überwachung. Nur nötig, wenn Sie LVM-Volumes nutzen."

#: mintcare/boot.py:36
msgid ""
"A drive mounted from /etc/fstab. Adding the options 'nofail,x-systemd."
"automount' mounts it on first access instead of during boot."
msgstr ""
"Ein Laufwerk aus /etc/fstab. Mit den Optionen 'nofail,x-systemd.automount' "
"wird es beim ersten Zugriff statt beim Start eingehängt."

#: mintcare/boot.py:107
msgid "Already disabled, but still started because "
msgstr "Bereits deaktiviert, wird aber trotzdem gestartet, weil "

#: mintcare/boot.py:108
msgid "another service"
msgstr "ein anderer Dienst"

