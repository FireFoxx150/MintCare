msgstr "Le volume dépasse 100 % ({0} %), ce qui peut déformer le son"

#: mintcare/troubleshoot.py:63
msgid "No default output is set"
msgstr "Aucune sortie par défaut définie"

#: mintcare/troubleshoot.py:199
#, python-brace-format
msgid "Weak Wi-Fi signal ({0}%) — move closer or use 5 GHz"
msgstr "Signal Wi-Fi faible ({0} %) — rapprochez-vous ou utilisez le 5 GHz"

#: mintcare/troubleshoot.py:201
#, python-brace-format
msgid ""
"{0} other networks share channel {1} — a 5 GHz band or another channel on "
"your router may be faster"
msgstr ""
"{0} autres réseaux partagent le canal {1} — la bande 5 GHz ou un autre canal "
"sur votre box peut être plus rapide"

#: mintcare/troubleshoot.py:204
#, python-brace-format
msgid ""
"{0} links at {1} Mb/s — a faulty cable or port can limit gigabit to 100 Mb/s"
msgstr ""
"{0} est connecté à {1} Mb/s — un câble ou un port défectueux peut limiter le "
"gigabit à 100 Mb/s"

#: mintcare/troubleshoot.py:210
#, python-brace-format
msgid "{0}% packet loss to your router — check Wi-Fi signal or the cable"
msgstr ""
"{0} % de paquets perdus vers votre box — vérifiez le signal Wi-Fi ou le câble"

#: mintcare/troubleshoot.py:214
msgid "No internet connection (1.1.1.1 unreachable)"
msgstr "Pas de connexion Internet (1.1.1.1 injoignable)"

#: mintcare/troubleshoot.py:222
#, python-brace-format
msgid "DNS lookups are slow ({0:.0f} ms) — try Optimise › Encrypted DNS"
msgstr ""
"Les requêtes DNS sont lentes ({0:.0f} ms) — essayez Optimiser › DNS chiffré"

#: mintcare/troubleshoot.py:232
msgid "Fixes fonts that look wrong or are missing in apps."
msgstr ""
"Corrige les polices qui s'affichent mal ou manquent dans les applications."

#: mintcare/troubleshoot.py:232
msgid "Rebuild the font cache"
msgstr "Reconstruire le cache des polices"

#: mintcare/troubleshoot.py:234
msgid "Refresh the application menu"
msgstr "Actualiser le menu des applications"

#: mintcare/troubleshoot.py:235
msgid "Fixes apps that are missing from the menu after an install or removal."
msgstr ""
"Corrige les applications absentes du menu après une installation ou une "
"suppression."

#: mintcare/troubleshoot.py:237
msgid "Lets file search find files added since the last update."
msgstr ""
"Permet à la recherche de trouver les fichiers ajoutés depuis la dernière "
"mise à jour."

#: mintcare/troubleshoot.py:237
msgid "Update the file search index"
msgstr "Mettre à jour l'index de recherche de fichiers"

#: mintcare/troubleshoot.py:254
msgid "The printing service (CUPS) isn't running"
msgstr "Le service d'impression (CUPS) n'est pas lancé"

#: mintcare/troubleshoot.py:273
msgid ""
"No default printer is set, so apps may ask every time or pick the wrong one"
msgstr ""
"Aucune imprimante par défaut, les applications peuvent donc demander à "
"chaque fois ou choisir la mauvaise"

#: mintcare/troubleshoot.py:280
#, python-brace-format
msgid "{0} print job(s) waiting — a stuck job blocks everything after it"
msgstr ""
"{0} tâche(s) d'impression en attente — une tâche bloquée bloque toutes les "
"suivantes"

#: mintcare/troubleshoot.py:285
#, python-brace-format
msgid ""
"The same printer is set up twice ({0} over the network and USB) — pick one "
"as the default"
msgstr ""
"La même imprimante est configurée deux fois ({0} en réseau et en USB) — "
"choisissez-en une par défaut"

#: mintcare/troubleshoot.py:298
#, python-brace-format
msgid "Resume printer {0}"
msgstr "Reprendre l'imprimante {0}"

#: mintcare/troubleshoot.py:309
msgid "No Bluetooth adapter found"
msgstr "Aucun adaptateur Bluetooth trouvé"

#: mintcare/troubleshoot.py:324
msgid "Bluetooth is switched off"
msgstr "Le Bluetooth est éteint"

#: mintcare/troubleshoot.py:327
#, python-brace-format
msgid "{0} battery is low ({1}%)"
msgstr "La batterie de {0} est faible ({1} %)"

#: mintcare/tweaks.py:316
msgid ""
"Google's BBR algorithm with the fq qdisc. Higher throughput and lower "
"latency on most connections, especially lossy Wi-Fi."
msgstr ""
"L'algorithme BBR de Google avec la qdisc fq. Meilleur débit et latence plus "
"faible sur la plupart des connexions, surtout en Wi-Fi instable."

#: mintcare/tweaks.py:325
msgid "Network stack tuning"
msgstr "Réglage de la pile réseau"

#: mintcare/tweaks.py:326
msgid ""
"TCP Fast Open, MTU probing and larger socket buffers (16 MB) for fast links."
msgstr ""
"TCP Fast Open, détection du MTU et tampons de socket plus grands (16 Mo) "
"pour les connexions rapides."

#: mintcare/tweaks.py:336
msgid "Encrypted DNS (Cloudflare + Quad9)"
msgstr "DNS chiffré (Cloudflare + Quad9)"

#: mintcare/tweaks.py:337
msgid ""
"Use 1.1.1.1 and 9.9.9.9 with opportunistic DNS-over-TLS through systemd-"
"resolved. Faster lookups and more privacy than many ISP resolvers."
msgstr ""
"Utilise 1.1.1.1 et 9.9.9.9 avec DNS-over-TLS opportuniste via systemd-"
"resolved. Requêtes plus rapides et plus de confidentialité que de nombreux "
"résolveurs de FAI."

#: mintcare/tweaks.py:354
msgid "Compressed RAM swap (zram)"
msgstr "Swap compressé en RAM (zram)"

#: mintcare/tweaks.py:356
#, no-python-format
msgid ""
"Adds a zstd-compressed swap device in RAM (50% of memory). Keeps the desktop "
"responsive under memory pressure and reduces SSD writes."
msgstr ""
"Ajoute un swap compressé zstd en RAM (50 % de la mémoire). Garde le bureau "
"réactif quand la mémoire manque et réduit les écritures sur le SSD."

#: mintcare/tweaks.py:372
msgid "Low swappiness (disk swap only)"
msgstr "Swappiness basse (swap sur disque uniquement)"

#: mintcare/tweaks.py:373
msgid ""
"Prefer RAM over a swap file/partition (swappiness 10, cache pressure 50). "
"Use this instead of zram if you keep plain disk swap."
msgstr ""
"Préfère la RAM au fichier ou à la partition de swap (swappiness 10, cache "
"pressure 50). À utiliser à la place de zram si vous gardez un swap disque "
"classique."

#: mintcare/tweaks.py:378
msgid "Smoother disk writeback"
msgstr "Écriture disque plus fluide"

#: mintcare/tweaks.py:379
msgid ""
"Flush dirty pages earlier (64 MB background / 256 MB max) so large copies to "
"USB sticks don't stall the desktop."
msgstr ""
"Écrit plus tôt les pages modifiées (64 Mo en arrière-plan / 256 Mo max) pour "
"que les grosses copies vers des clés USB ne figent pas le bureau."

#: mintcare/tweaks.py:386
msgid "Weekly SSD TRIM"
msgstr "TRIM hebdomadaire du SSD"

#: mintcare/tweaks.py:387
msgid ""
"Enable fstrim.timer so SSDs are trimmed weekly, keeping write speeds up."
msgstr ""
"Active fstrim.timer pour que les SSD soient optimisés chaque semaine et "
"gardent leur vitesse d'écriture."

#: mintcare/tweaks.py:393
msgid "Cap system logs at 200 MB"
msgstr "Limiter les journaux système à 200 Mo"

#: mintcare/tweaks.py:394
msgid ""
"Limit the systemd journal to 200 MB and 1 month so logs never fill the disk."
msgstr ""
"Limite le journal systemd à 200 Mo et 1 mois pour que les journaux ne "
"remplissent jamais le disque."

#: mintcare/tweaks.py:408
msgid "Automatic old-kernel/orphan removal"
msgstr "Suppression automatique des anciens noyaux et orphelins"

#: mintcare/tweaks.py:409
msgid ""
"Turn on Mint Update's weekly automation that removes obsolete kernels and "
"orphaned packages."
msgstr ""
"Active l'automatisation hebdomadaire de Mint Update qui supprime les noyaux "
"obsolètes et les paquets orphelins."

#: mintcare/tweaks.py:418 mintcare/tweaks.py:431 mintcare/tweaks.py:500
msgid "Boot & Services"
msgstr "Démarrage et services"

#: mintcare/tweaks.py:418
msgid "Faster shutdown"
msgstr "Arrêt plus rapide"

#: mintcare/tweaks.py:419
msgid ""
"Wait at most 10 s (instead of 90 s) for hung services when shutting down."
msgstr ""
"Attendre au plus 10 s (au lieu de 90 s) les services bloqués à l'arrêt."

#: mintcare/tweaks.py:431
msgid "Skip 'wait for network' at boot"
msgstr "Ne pas « attendre le réseau » au démarrage"

#: mintcare/tweaks.py:432
msgid ""
"Disable NetworkManager-wait-online, which can add several seconds to boot. "
"Leave this off if you mount network shares (NFS/SMB) in /etc/fstab."
msgstr ""
"Désactive NetworkManager-wait-online, qui peut ajouter plusieurs secondes au "
"démarrage. Laissez-le désactivé si vous montez des partages réseau (NFS/SMB) "
"dans /etc/fstab."

#: mintcare/tweaks.py:441
msgid "Enable the firewall: block all incoming connections, allow outgoing."
msgstr ""
"Activer le pare-feu : bloquer toutes les connexions entrantes, autoriser les "
"sortantes."

#: mintcare/tweaks.py:447
msgid "Automatic updates"
msgstr "Mises à jour automatiques"

#: mintcare/tweaks.py:448
msgid ""
"Let Mint Update install updates automatically in the background (Timeshift "
"snapshot recommended)."
msgstr ""
"Laisser Mint Update installer automatiquement les mises à jour en arrière-"
"plan (instantané Timeshift recommandé)."

#: mintcare/tweaks.py:455
msgid "CPU microcode updates"
msgstr "Mises à jour du microcode du processeur"

#: mintcare/tweaks.py:456
msgid ""
"Install the vendor microcode package: fixes CPU bugs and security issues."
msgstr ""
"Installe le paquet de microcode du fabricant : corrige des bogues et failles "
"de sécurité du processeur."

#: mintcare/tweaks.py:461
msgid "Kernel network and file hardening"
msgstr "Renforcement du noyau pour le réseau et les fichiers"

#: mintcare/tweaks.py:462
msgid ""
"Settings Lynis suggests that do not break VPNs, Docker or drivers: stop "
"sending ICMP redirects, refuse source-routed packets, log impossible "
"addresses, protect FIFOs in shared folders and add the process ID to core "
"dump names."
msgstr ""
"Réglages suggérés par Lynis qui ne perturbent ni les VPN, ni Docker, ni les "
"pilotes : ne plus envoyer de redirections ICMP, refuser les paquets routés "
"par la source, journaliser les adresses impossibles, protéger les FIFO dans "
"les dossiers partagés et ajouter l'identifiant du processus au nom des "
"fichiers core."

#: mintcare/tweaks.py:476
msgid "Best I/O scheduler per drive"
msgstr "Meilleur ordonnanceur d'E/S par disque"

#: mintcare/tweaks.py:477
msgid ""
"NVMe: none · SATA SSD: mq-deadline · hard drives: BFQ. BFQ keeps the desktop "
"responsive while a hard drive is busy copying or indexing."
msgstr ""
"NVMe : none · SSD SATA : mq-deadline · disques durs : BFQ. BFQ garde le "
"bureau réactif pendant qu'un disque dur copie ou indexe."

#: mintcare/tweaks.py:500
msgid "Faster boot menu (GRUB)"
msgstr "Menu de démarrage plus rapide (GRUB)"

#: mintcare/tweaks.py:501
msgid ""
"After a crash or power cut Ubuntu-based systems show the GRUB menu for 30 s. "
"This cuts that to 5 s and keeps the normal menu short (2 s, or 3 s when dual-"
"booting). Uses a drop-in file; /etc/default/grub is not edited and grub.cfg "
"is backed up first."
msgstr ""
"Après un plantage ou une coupure de courant, les systèmes basés sur Ubuntu "
"affichent le menu GRUB pendant 30 s. Ceci le réduit à 5 s et garde le menu "
"normal court (2 s, ou 3 s en double amorçage). Utilise un fichier séparé ; /"
"etc/default/grub n'est pas modifié et grub.cfg est sauvegardé d'abord."

#: mintcare/tweaks.py:512 mintcare/tweaks.py:517 mintcare/tweaks.py:527
#: mintcare/tweaks.py:543 mintcare/tweaks.py:550 mintcare/tweaks.py:560
#: mintcare/tweaks.py:674
msgid "Gaming"
msgstr "Jeux"

#: mintcare/tweaks.py:512
msgid "Raise vm.max_map_count"
msgstr "Augmenter vm.max_map_count"

#: mintcare/tweaks.py:513
msgid ""
"Raise the memory-map limit to SteamOS's value. Prevents crashes in some "
"Proton/Steam games (e.g. CS2, Hogwarts Legacy)."
msgstr ""
"Porte la limite de projections mémoire à la valeur de SteamOS. Évite des "
"plantages dans certains jeux Proton/Steam (p. ex. CS2, Hogwarts Legacy)."

#: mintcare/tweaks.py:517
msgid "Feral GameMode"
msgstr "Feral GameMode"

#: mintcare/tweaks.py:518
msgid ""
"Temporarily boosts CPU/GPU performance while a game runs. Also adds you to "
"the 'gamemode' group, which GameMode needs to switch CPU governors (log out "
"and back in afterwards). Launch games with: gamemoderun %command%"
msgstr ""
"Augmente temporairement les performances CPU/GPU pendant un jeu. Vous ajoute "
"aussi au groupe « gamemode », nécessaire à GameMode pour changer le "
"gouverneur du processeur (déconnectez-vous puis reconnectez-vous ensuite). "
"Lancez les jeux avec : gamemoderun %command%"

#: mintcare/tweaks.py:527
msgid "GameMode performance profile"
msgstr "Profil de performance GameMode"

#: mintcare/tweaks.py:528
msgid ""
"While gaming: performance CPU governor, higher process and I/O priority, "
"screensaver blocked"
msgstr ""
"En jeu : gouverneur CPU performance, priorité processus et E/S plus élevée, "
"économiseur d'écran bloqué"

#: mintcare/tweaks.py:529
msgid ", NVIDIA 'prefer maximum performance'"
msgstr ", NVIDIA « performances maximales préférées »"

#: mintcare/tweaks.py:543
msgid "MangoHud + GOverlay"
msgstr "MangoHud + GOverlay"

#: mintcare/tweaks.py:544
msgid ""
"In-game overlay for FPS, frame times, temperatures and load, plus GOverlay "
"to configure it. Launch games with: mangohud %command%"
msgstr ""
"Superposition en jeu pour les FPS, temps d'image, températures et charge, "
"plus GOverlay pour la configurer. Lancez les jeux avec : mangohud %command%"

#: mintcare/tweaks.py:550
msgid "Steam (with Proton)"
msgstr "Steam (avec Proton)"

#: mintcare/tweaks.py:551
msgid ""
"Installs Steam from Flathub plus controller udev rules (steam-devices). "
"Proton lets Steam run most Windows games; Steam asks you to accept its "
"licence on first launch."
msgstr ""
"Installe Steam depuis Flathub avec les règles udev des manettes (steam-"
"devices). Proton permet à Steam de lancer la plupart des jeux Windows ; "
"Steam vous demande d'accepter sa licence au premier lancement."

#: mintcare/tweaks.py:560
msgid "ProtonUp-Qt (Proton-GE manager)"
msgstr "ProtonUp-Qt (gestionnaire de Proton-GE)"

#: mintcare/tweaks.py:561
msgid ""
"Installs and updates community Proton builds such as Proton-GE, which fix "
"videos and compatibility in many games."
msgstr ""
"Installe et met à jour des versions communautaires de Proton comme Proton-"
"GE, qui corrigent vidéos et compatibilité dans de nombreux jeux."

#: mintcare/tweaks.py:570 mintcare/tweaks.py:575 mintcare/tweaks.py:582
#: mintcare/tweaks.py:681
msgid "Developer"
msgstr "Développement"

#: mintcare/tweaks.py:570
msgid "More file watchers"
msgstr "Plus de surveillances de fichiers"

#: mintcare/tweaks.py:571
msgid ""
"Raise inotify limits so VS Code, IDEs and dev servers can watch large "
"projects."
msgstr ""
"Augmente les limites inotify pour que VS Code, les IDE et les serveurs de "
"développement puissent surveiller de gros projets."

#: mintcare/tweaks.py:575
msgid "Install Nala (faster apt front-end)"
msgstr "Installer Nala (interface apt plus rapide)"

#: mintcare/tweaks.py:576
msgid ""
"Nala downloads packages in parallel and shows clearer output. Use 'nala' "
"anywhere you would type 'apt'."
msgstr ""
"Nala télécharge les paquets en parallèle et affiche une sortie plus claire. "
"Utilisez « nala » partout où vous taperiez « apt »."

#: mintcare/tweaks.py:582
msgid "Install essential tools"
msgstr "Installer les outils essentiels"

#: mintcare/tweaks.py:583
msgid ""
"build-essential, curl, git, htop, btop, unzip and fastfetch (where "
"available)."
msgstr ""
"build-essential, curl, git, htop, btop, unzip et fastfetch (si disponible)."

#: mintcare/tweaks.py:591 mintcare/tweaks.py:599 mintcare/tweaks.py:616
#: mintcare/tweaks.py:629
msgid "Laptop"
msgstr "Portable"

#: mintcare/tweaks.py:591
msgid "Remove TLP / power-profiles conflict"
msgstr "Supprimer le conflit TLP / power-profiles"

#: mintcare/tweaks.py:592
msgid ""
"Having both TLP and power-profiles-daemon running causes erratic power "
"management. This removes TLP and keeps Mint's power-profiles-daemon."
msgstr ""
"Faire tourner TLP et power-profiles-daemon ensemble rend la gestion "
"d'énergie erratique. Ceci supprime TLP et garde power-profiles-daemon de "
"Mint."

#: mintcare/tweaks.py:599
msgid "Battery charge limit"
msgstr "Limite de charge de la batterie"

#: mintcare/tweaks.py:600
msgid ""
"Stop charging at the level in the box to help the battery last longer when "
"the laptop lives on the charger. Switch the tweak off and on again after "
"changing the level. Only shown when the battery firmware supports it."
msgstr ""
"Arrête la charge de la batterie à ce niveau, pour qu'elle dure plus "
"longtemps quand l'ordinateur est branché. Désactivez puis réactivez ce "
"réglage après avoir changé le niveau. Affiché seulement si le micrologiciel "
"de la batterie le permet."

#: mintcare/tweaks.py:616
msgid "Power saver on battery"
msgstr "Économie d'énergie sur batterie"

#: mintcare/tweaks.py:617
msgid ""
"Switch to the power-saver profile when you unplug and back to balanced when "
"you plug in (power-profiles-daemon)."
msgstr ""
"Passe au profil économie d'énergie quand vous débranchez, et revient à "
"équilibré quand vous branchez (power-profiles-daemon)."

#: mintcare/tweaks.py:629
msgid "PCIe power saving (ASPM)"
msgstr "Économie d'énergie PCIe (ASPM)"

#: mintcare/tweaks.py:630
msgid ""
"Let PCIe devices (Wi-Fi, NVMe, GPU links) drop into low-power states when "
"idle. Typically saves 0.5–2 W. If a device misbehaves, switch this off."
msgstr ""
"Laisse les périphériques PCIe (Wi-Fi, NVMe, liens GPU) passer en basse "
"consommation au repos. Économise en général 0,5 à 2 W. Si un périphérique se "
"comporte mal, désactivez-le."

#: mintcare/tweaks.py:641
msgid "Turn off desktop effects"
msgstr "Désactiver les effets du bureau"

#: mintcare/tweaks.py:642
msgid ""
"Windows open, close, minimise and switch workspaces instantly instead of "
"animating. Snappier on older or busy PCs. Applies to your account straight "
"away; no password needed."
msgstr ""
"Les fenêtres s'ouvrent, se ferment, se réduisent et changent d'espace de "
"travail instantanément au lieu d'être animées. Plus réactif sur les PC "
"anciens ou chargés. S'applique à votre compte tout de suite, sans mot de "
"passe."

#: mintcare/tweaks.py:647
msgid "Full-screen games skip the compositor"
msgstr "Les jeux en plein écran contournent le compositeur"

#: mintcare/tweaks.py:648
msgid ""
"Lets full-screen games and videos draw straight to the screen, which raises "
"frame rates and cuts input lag. Some videos may tear slightly."
msgstr ""
"Laisse les jeux et vidéos en plein écran dessiner directement à l'écran, ce "
"qui augmente les images par seconde et réduit la latence. Certaines vidéos "
"peuvent légèrement se déchirer."

#: mintcare/tweaks.py:672
msgid "Everyday desktop"
msgstr "Bureau au quotidien"

#: mintcare/tweaks.py:673
msgid ""
"Faster networking, zram, SSD care, firewall, tidy logs and a quick boot menu."
msgstr ""
"Réseau plus rapide, zram, entretien du SSD, pare-feu, journaux rangés et "
"menu de démarrage rapide."

#: mintcare/tweaks.py:675
msgid ""
"Everyday tweaks plus GameMode, MangoHud, Steam with Proton and the SteamOS "
"memory-map limit."
msgstr ""
"Réglages du quotidien plus GameMode, MangoHud, Steam avec Proton et la "
"limite de projections mémoire de SteamOS."

#: mintcare/tweaks.py:678
msgid "Laptop battery"
msgstr "Batterie du portable"

#: mintcare/tweaks.py:679
msgid ""
"Everyday tweaks plus charge limiting, power saver on battery and PCIe power "
"saving."
msgstr ""
"Réglages du quotidien plus limite de charge, économie d'énergie sur batterie "
"et économie d'énergie PCIe."

#: mintcare/tweaks.py:682
msgid "Everyday tweaks plus large file-watcher limits, Nala and build tools."
msgstr ""
"Réglages du quotidien plus limites élevées de surveillance de fichiers, Nala "
"et outils de compilation."

#~ msgid "Choose a model for the local assistant first."
#~ msgstr "Choisissez d'abord un modèle pour l'assistant local."

#~ msgid "Thinking…"
#~ msgstr "Réflexion…"

#, python-brace-format
