msgstr "Signal Wi-Fi faible ({0} %) — rapprochez-vous ou utilisez le 5 GHz"

#: mintcare/troubleshoot.py:201
#, python-brace-format
msgid ""
"{0} other networks share channel {1} — a 5 GHz band or another channel on "
"your router may be faster"
msgstr ""
"{0} autres réseaux partagent le canal {1} — la bande 5 GHz ou un autre canal "
"sur votre box peut être plus rapide"

#: mintcare/troubleshoot.py:204
#, python-brace-format
msgid ""
"{0} links at {1} Mb/s — a faulty cable or port can limit gigabit to 100 Mb/s"
msgstr ""
"{0} est connecté à {1} Mb/s — un câble ou un port défectueux peut limiter le "
"gigabit à 100 Mb/s"

#: mintcare/troubleshoot.py:210
#, python-brace-format
