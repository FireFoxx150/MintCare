msgstr "Votre sortie par défaut « {0} » est muette"

#: mintcare/troubleshoot.py:59
#, python-brace-format
msgid "Volume is very low ({0}%)"
msgstr "Le volume est très bas ({0} %)"

#: mintcare/troubleshoot.py:61
#, python-brace-format
