#, python-brace-format
msgid "{0} file could not be copied, so it is not in this backup"
msgid_plural "{0} files could not be copied, so they are not in this backup"
msgstr[0] ""
"{0} fichier n'a pas pu être copié, il n'est donc pas dans cette sauvegarde"
msgstr[1] ""
"{0} fichiers n'ont pas pu être copiés, ils ne sont donc pas dans cette "
"sauvegarde"

#: mintcare/backup.py:200
#, python-brace-format
