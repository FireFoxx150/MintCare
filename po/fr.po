msgstr "Les dossiers sont imbriqués trop profondément pour être analysés."

#: mintcare/space.py:327
msgid "Timeshift is not set up."
msgstr "Timeshift n'est pas configuré."

#: mintcare/space.py:329
msgid "BTRFS snapshots are managed inside Timeshift."
msgstr "Les instantanés BTRFS sont gérés dans Timeshift."

#: mintcare/space.py:332
msgid ""
"The Timeshift backup drive isn't mounted, so snapshots can't be listed here."
msgstr ""
"Le disque de sauvegarde de Timeshift n'est pas monté, les instantanés ne "
"peuvent donc pas être listés ici."

#: mintcare/space.py:383
msgid "The backup drive isn't the one you trusted, so nothing was restored."
msgstr ""
"Le disque de sauvegarde n'est pas celui que vous avez approuvé, rien n'a "
"donc été restauré.Le disque de sauvegarde de Timeshift n'est pas monté, les "
"instantanés ne peuvent donc pas être listés ici."

#: mintcare/space.py:389
msgid ""
"No backup drive is trusted yet. Use Trust this drive first, then restore "
"again."
msgstr ""
"Aucun disque de sauvegarde n'est encore approuvé. Utilisez d'abord « Faire "
"confiance à ce disque », puis restaurez à nouveau."

#: mintcare/space.py:406
msgid "Couldn't read this drive's serial number, so it can't be trusted."
msgstr ""
"Impossible de lire le numéro de série de ce disque : il ne peut pas être "
"approuvé."

#: mintcare/space.py:438
#, python-brace-format
msgid "{0} has the setuid or setgid bit set, so it is not restored."
msgstr "{0} a le bit setuid ou setgid activé, il n'est donc pas restauré."

#: mintcare/space.py:440
#, python-brace-format
msgid "{0} has file capabilities set, so it is not restored."
msgstr "{0} a des capacités de fichier activées, il n'est donc pas restauré."

