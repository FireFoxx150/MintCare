msgstr ""
"{0} % de paquets perdus vers votre box — vérifiez le signal Wi-Fi ou le câble"

#: mintcare/troubleshoot.py:214
msgid "No internet connection (1.1.1.1 unreachable)"
msgstr "Pas de connexion Internet (1.1.1.1 injoignable)"

#: mintcare/troubleshoot.py:222
#, python-brace-format
msgid "DNS lookups are slow ({0:.0f} ms) — try Optimise › Encrypted DNS"
msgstr ""
"Les requêtes DNS sont lentes ({0:.0f} ms) — essayez Optimiser › DNS chiffré"

#: mintcare/troubleshoot.py:238
msgid "The printing service (CUPS) isn't running"
msgstr "Le service d'impression (CUPS) n'est pas lancé"

#: mintcare/troubleshoot.py:257
