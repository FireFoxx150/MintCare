#: mintcare/backup.py:84
msgid "No backup destination chosen yet"
msgstr "Aucune destination de sauvegarde choisie"

#: mintcare/backup.py:87
#, python-brace-format
msgid "{0} isn't available — is the drive connected and mounted?"
msgstr "{0} n'est pas disponible — le disque est-il branché et monté ?"

#: mintcare/backup.py:89
#, python-brace-format
msgid "You can't write to {0}"
msgstr "Impossible d'écrire dans {0}"

#: mintcare/backup.py:92
msgid ""
"This folder is on the same drive as your home folder — if that drive fails, "
"the backup goes with it. Choose another drive."
msgstr ""
"Ce dossier est sur le même disque que votre dossier personnel — si ce disque "
"tombe en panne, la sauvegarde disparaît avec lui. Choisissez un autre disque."

#: mintcare/backup.py:98
#, python-brace-format
msgid ""
"The drive uses {0}, which can't hard-link files, so every snapshot is a full "
"copy. ext4 or NTFS saves a lot of space."
msgstr ""
"Le disque utilise {0}, qui ne gère pas les liens physiques : chaque "
"instantané est donc une copie complète. ext4 ou NTFS économisent beaucoup de "
"place."

#: mintcare/backup.py:100
msgid "unknown filesystem"
msgstr "système de fichiers inconnu"

#: mintcare/backup.py:100
#, python-brace-format
msgid "{0} free on the destination ({1})"
msgstr "{0} libres sur la destination ({1})"

#: mintcare/backup.py:132 mintcare/backup.py:309
msgid "None of the chosen folders exist"
msgstr "Aucun des dossiers choisis n'existe"

#: mintcare/backup.py:172
#, python-brace-format
