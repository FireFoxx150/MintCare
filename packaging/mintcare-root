#!/bin/bash
# Privileged half of MintCare, started through pkexec (polkit action org.mintcare.run).
# Reads one batch script on stdin. The app seals the batch in memory before the
# password prompt, and root runs only a private copy made here. ROOT_RUN in
# mintcare/runner.py has the same logic, so keep the two in step.
set -u
[ "$(id -u)" -eq 0 ] || { echo "mintcare-root must run as root" >&2; exit 126; }
[ $# -eq 0 ] || { echo "usage: mintcare-root < SCRIPT" >&2; exit 2; }
# mktemp -d makes a folder owned by root with mode 0700, so no other user can change the copy.
work=$(mktemp -d /tmp/mintcare-batch.XXXXXXXX) || exit 1
trap 'rm -rf -- "$work"' EXIT
cat > "$work/batch.sh" && [ -s "$work/batch.sh" ] && /bin/bash "$work/batch.sh" </dev/null
